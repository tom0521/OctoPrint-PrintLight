<a id="printlight_indicator" class="pull-right off" title="Toggle Light" href="#" data-bind="click: function() { $root.toggleLight(); }, visible: (isLightOn() !== undefined)" style="display: none">
	<i class="far fa-lightbulb"></i>
</a>
<a id="printlight_psu_indicator" class="pull-right off" title="Toggle PSU" href="#" data-bind="click: function() { $root.togglePsu(); }, visible: (isPsuOn() !== undefined)" style="display: none">
	<i class="fas fa-power-off"></i>
</a>
